ent-BaseWeaponPistol = BasePistol
    .desc = Дерзай - налетай, целься и стреляй.
ent-WeaponPistolViper = Гадюка
    .desc = Небольшой, легко скрываемый, но маломощный пистолет. Оснащён полностью автоматическим ресивером. Использует патроны калибра .35 авто.
    .suffix = Пистолет
ent-WeaponPistolViperEmpty = PTA Viper 9x19mm
    .suffix = Empty
    .desc = { ent-WeaponPistolViper.desc }
ent-WeaponPistolViperSecurity = PTA Viper 9x19mm
    .desc = A small, easily concealable, but somewhat underpowered gun, produced by a bulk arms manufacturer now defunct for over a century. Uses 9x19mm PSTF ammo. The serial number on the handguard marks this gun as belonging to some sort of corporate security.
    .suffix = Security Loadouts
ent-WeaponPistolViperNonLethal = { ent-WeaponPistolViper }
